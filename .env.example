# Copy to .env.local and fill in. Also set these in your Vercel project
# (Project → Settings → Environment Variables). Everything NEXT_PUBLIC_ is
# public by design — it ships to the browser — so keep the Supabase
# service_role key out of here entirely.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Payouts (Stellar testnet) -----------------------------------------------
# The account claims are paid from. Create a testnet keypair at
# https://laboratory.stellar.org/#account-creator?network=test and fund it with
# friendbot (the admin panel has a button for that too).
#
# The public key is an address and ships to the browser. The secret NEVER does:
# it has no NEXT_PUBLIC_ prefix, so it stays server-side, and only the claim
# route (src/app/api/claims/route.ts) ever reads it.
NEXT_PUBLIC_STELLAR_TREASURY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_TREASURY_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Admin panel -------------------------------------------------------------
# Wallets allowed into /admin, comma-separated. Public by necessity: the gate
# is a convenience, not a security boundary (see src/lib/admin.ts).
NEXT_PUBLIC_ADMIN_WALLETS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Consent receipts (Soroban) ----------------------------------------------
# The deployed consent contract. Public by design: verifying a receipt is meant
# to need nobody's permission, so the address ships to the browser and anyone
# can call is_valid on it themselves. Source in contracts/contracts/consent.
#
# Deploy your own with:
#   cd contracts && stellar contract build
#   stellar contract deploy --wasm target/wasm32v1-none/release/consent.wasm \
#     --source <your-key> --network testnet -- --admin <your-address>
NEXT_PUBLIC_CONSENT_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
